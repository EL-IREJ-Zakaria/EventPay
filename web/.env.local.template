# EventPay Web Firebase Configuration Template
# Copy this file to .env.local and fill in your values from Firebase Console

# Get these values from Firebase Console > Project Settings > Web App
NEXT_PUBLIC_FIREBASE_API_KEY=your_api_key_here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=1:your_sender_id:web:your_web_app_id

# Set to 'true' to use Firebase emulators in development
NEXT_PUBLIC_USE_EMULATORS=false
