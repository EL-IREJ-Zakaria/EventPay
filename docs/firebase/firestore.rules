rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ═══════════════════════════════════════════════════════════════
    // HELPER FUNCTIONS
    // ═══════════════════════════════════════════════════════════════
    
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function getUser(userId) {
      return get(/databases/$(database)/documents/users/$(userId));
    }
    
    function isAdmin() {
      return isAuthenticated() && getUser(request.auth.uid).data.role == 'ADMIN';
    }
    
    function isScanner() {
      return isAuthenticated() && getUser(request.auth.uid).data.role == 'SCANNER';
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    function isAssignedToEvent(eventId) {
      return isScanner() && request.auth.uid in get(/databases/$(database)/documents/events/$(eventId)).data.assignedScanners;
    }
    
    function isValidEmail(email) {
      return email.matches('^[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\\.[A-Za-z]{2,}$');
    }
    
    // ═══════════════════════════════════════════════════════════════
    // USERS COLLECTION
    // ═══════════════════════════════════════════════════════════════
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      
      allow create: if (isAuthenticated() && request.auth.uid == userId
        && isValidEmail(request.resource.data.email)
        && request.resource.data.role in ['ADMIN', 'SCANNER'])
        || (isAdmin() && isValidEmail(request.resource.data.email));
      
      allow update: if isAdmin() 
        || (isOwner(userId) && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['fullName', 'phone', 'profileImageUrl', 'preferences', 'lastLoginAt']));
      
      allow delete: if isAdmin() && request.auth.uid != userId;
    }
    
    // ═══════════════════════════════════════════════════════════════
    // EVENTS COLLECTION
    // ═══════════════════════════════════════════════════════════════
    match /events/{eventId} {
      allow read: if isAdmin() 
        || (isScanner() && request.auth.uid in resource.data.assignedScanners)
        || (isAuthenticated() && resource.data.isPublished == true);
      
      allow create: if isAdmin()
        && request.resource.data.totalTickets >= 0
        && request.resource.data.date < request.resource.data.endDate;
      
      // Admin can update any event (stats, check-in count, assigned scanners, etc.)
      allow update: if isAdmin()
        && request.resource.data.totalTickets >= resource.data.reservedTickets;
      
      // Scanners can update checkedInCount only on assigned events
      allow update: if isScanner()
        && isAssignedToEvent(eventId)
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['checkedInCount', 'reservedTickets']);
      
      allow delete: if isAdmin()
        && resource.data.reservedTickets == 0;
    }
    
    // ═══════════════════════════════════════════════════════════════
    // TICKETS COLLECTION
    // ═══════════════════════════════════════════════════════════════
    match /tickets/{ticketId} {
      allow read: if isAdmin() 
        || isOwner(resource.data.userId)
        || (isScanner() && isAssignedToEvent(resource.data.eventId));
      
      allow create: if isAdmin()
        && request.resource.data.status in ['ACTIVE', 'USED', 'CANCELLED', 'EXPIRED']
        && request.resource.data.ticketType in ['STANDARD', 'VIP', 'EARLY_BIRD'];
      
      allow update: if isAdmin()
        || (isScanner() && isAssignedToEvent(resource.data.eventId)
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['status', 'checkedInAt', 'checkedInBy']));
      
      allow delete: if isAdmin();
    }
    
    // ═══════════════════════════════════════════════════════════════
    // CHECK-INS COLLECTION (APPEND-ONLY AUDIT)
    // ═══════════════════════════════════════════════════════════════
    match /checkIns/{checkInId} {
      allow read: if isAdmin() 
        || (isScanner() && resource.data.scannedBy == request.auth.uid);
      
      allow create: if isAuthenticated()
        && request.resource.data.scannedBy == request.auth.uid
        && (isAdmin() || isAssignedToEvent(request.resource.data.eventId))
        && request.resource.data.result in ['SUCCESS', 'ALREADY_SCANNED', 'INVALID', 'NOT_FOUND', 'ERROR', 'WRONG_EVENT', 'EXPIRED', 'CANCELLED', 'NO_PERMISSION'];
      
      allow update, delete: if false;
    }
    
    // ═══════════════════════════════════════════════════════════════
    // SCANNER ASSIGNMENTS COLLECTION
    // ═══════════════════════════════════════════════════════════════
    match /scannerAssignments/{assignmentId} {
      allow read: if isAdmin() 
        || (isScanner() && resource.data.scannerId == request.auth.uid);
      
      allow create, update: if isAdmin();
      allow delete: if isAdmin();
    }
    
    // ═══════════════════════════════════════════════════════════════
    // AUDIT LOGS COLLECTION (APPEND-ONLY)
    // ═══════════════════════════════════════════════════════════════
    match /auditLogs/{logId} {
      allow read: if isAdmin();
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if false;
    }
    
    // ═══════════════════════════════════════════════════════════════
    // EVENT ANALYTICS COLLECTION
    // ═══════════════════════════════════════════════════════════════
    match /eventAnalytics/{analyticsId} {
      allow read: if isAdmin();
      allow create, update: if isAdmin();
      allow delete: if false;
    }
    
    // ═══════════════════════════════════════════════════════════════
    // ANALYTICS COLLECTION
    // ═══════════════════════════════════════════════════════════════
    match /analytics/{document=**} {
      allow read: if isAdmin();
      allow create, update: if isAdmin();
      allow delete: if false;
    }
    
    // ═══════════════════════════════════════════════════════════════
    // NOTIFICATIONS COLLECTION
    // ═══════════════════════════════════════════════════════════════
    match /notifications/{notifId} {
      allow read: if isAdmin() || isOwner(resource.data.userId);
      allow create: if isAdmin();
      allow update: if isOwner(resource.data.userId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read', 'readAt']);
      allow delete: if isAdmin();
    }
    
    // ═══════════════════════════════════════════════════════════════
    // DEFAULT DENY
    // ═══════════════════════════════════════════════════════════════
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
